# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.crt
*.csr
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.staging*

# secrets and sensitive config
config/secrets.*
.aws/credentials
.ssh/id_rsa
auth.json
credentials.json

#github // copilot instructions
.github/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# commit planning files (don't commit these)
*commit-plan.md
execute-commits.bat

#ignore testsprite_tests
/testsprite_tests/tmp/*

#ignore mcp.json
/mcp.json

#ignore learn_Doc folder
/learn_Doc/*